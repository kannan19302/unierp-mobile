{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "UniERP Mobile (Chrome Web)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "deviceId": "chrome",
      "args": ["--web-port", "8085"]
    },
    {
      "name": "UniERP Mobile (Windows Desktop)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "deviceId": "windows"
    },
    {
      "name": "UniERP Mobile (Web Server)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "deviceId": "web-server",
      "args": ["--web-port", "8085"]
    }
  ]
}
